PORT=3000
NODE_ENV=development

# Cole aqui a Connection String do Neon (branch dev ou main)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Origens permitidas pelo CORS, separadas por vírgula
# Dev: não precisa definir (qualquer origem é aceita quando NODE_ENV=development)
# Produção: URL do seu front-end hospedado
ALLOWED_ORIGINS=https://seu-front.vercel.app

# Cloudinary — storage de fotos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
